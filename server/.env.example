NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/trainerdesk
MONGO_TEST_URI=mongodb://127.0.0.1:27017/trainerdesk_test
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Use COOKIE_SAME_SITE=none over HTTPS when frontend and backend are on different domains (e.g. Vercel + Render)
COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
